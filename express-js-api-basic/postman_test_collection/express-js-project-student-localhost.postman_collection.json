							"\tpm.expect(jsonResponse).to.have.property('token');\r",
							"});\r",
							"\r",
							"pm.test(\"Has requested_date_time property\", () => {\r",
							"\tpm.expect(jsonResponse).to.have.property('requested_date_time');\r",
							"});\r",
							"\r",
							"pm.test(\"Has expired_by property\", () => {\r",
							"\tpm.expect(jsonResponse).to.have.property('expired_by');\r",
							"});\r",
							"\r",
							"pm.test(\"userid is number\", () => {\r",
							"\tpm.expect(jsonResponse.userid).to.be.a('number');\r",
							"});\r",
							"\r",
							"pm.test(\"token is string\", () => {\r",
							"\tpm.expect(jsonResponse.token).to.be.a('string', \"Token is not a string\");\r",
							"});\r",
							"\r",
							"pm.test(\"token has length of 500\", () => {\r",
							"\t\r",
							"\tpm.expect(jsonResponse.token.length).to.be.below(500, \"token length is not less than equal 500\");\t\r",
							"});\r",
							"\r",
							"pm.test(\"requested_date_time is date and time\", () => {\r",
							"\tpm.expect(moment(jsonResponse.requested_date_time).isValid()).to.be.true;\r",
							"});\r",
